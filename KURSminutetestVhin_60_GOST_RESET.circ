    </comp>
    <comp lib="9" loc="(525,865)" name="Text">
      <a name="text" val="строку полностью заполенную оно считает... странно, но правильно - в 2 цикла сброса CI_BIT_COUNT до 64 фактически"/>
    </comp>
    <comp lib="9" loc="(550,755)" name="Text">
      <a name="text" val="Пока бит данных и бит цвета равны, то есть COMP_IN = 0, у нас продолжается зацикленная работа с сумматором."/>
    </comp>
    <comp lib="9" loc="(615,775)" name="Text">
      <a name="text" val="Как только бит данных и бит цвета перестанут быть равны, то есть COMP_IN = 1, у нас начинается новая серия серия с единицы."/>
    </comp>
