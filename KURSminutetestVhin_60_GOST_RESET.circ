    <comp lib="6" loc="(280,730)" name="Button"/>
    <comp lib="9" loc="(1005,825)" name="Text">
      <a name="text" val="Из огня да в полымя."/>
    </comp>
    <comp lib="9" loc="(1175,805)" name="Text">
      <a name="text" val="Возможно, сброс счёта PC эту проблему решит. А может и нет. "/>
    </comp>
    <comp lib="9" loc="(1260,1085)" name="Text">
      <a name="text" val="XOR_OUT - важный выход. Он - индикатор окончания серии."/>
    </comp>
    <comp lib="9" loc="(1265,910)" name="Text">
      <a name="text" val="Я ПОНЯЛ ПОЧЕМУ! PUSH действует сначала в 0001000, а потом в 0010000 раз в 2 цикла. "/>
    </comp>
    <comp lib="9" loc="(1315,990)" name="Text">
      <a name="text" val="То есть на что делится проблема: Если мы привязываем PUSH только к XOR, то ломается логика &quot;32 одного цвета подряд&quot;. Если привязываем через OR с концом строки - ломается подача. Нужен принудительный сброс счётчика и отправка PUSH."/>
    </comp>
    <comp lib="9" loc="(1380,885)" name="Text">
      <a name="text" val="Выход COMP_IN принимает значение 0001000 только один раз - в начале. А FIFO почему-то его по кд прокручивает."/>
    </comp>
    <comp lib="9" loc="(1410,615)" name="Text">
      <a name="text" val="В том случае, когда пиксели в строке все одинаковые:"/>
    </comp>
    <comp lib="9" loc="(1415,465)" name="Text">
      <a name="text" val="Слово 7 бит"/>
    </comp>
    <comp lib="9" loc="(1415,645)" name="Text">
      <a name="text" val="Нужен принудительный PUSH когда будет досчёт до 32"/>
    </comp>
    <comp lib="9" loc="(1460,775)" name="Text">
      <a name="text" val="От принудительного Push появляются глюки с информацией в FIFO... Либо увеличивать слово COMP_STR до 8 бит, либо думы думать"/>
    </comp>
    <comp lib="9" loc="(1465,670)" name="Text">
      <a name="text" val="Теперь надо решить проблему с тем, что счётчик считает всё далее"/>
    </comp>
    <comp lib="9" loc="(1565,925)" name="Text">
      <a name="text" val="То есть нам в данном случае МЕШАЕТ подсчёт до конца строки. Однако сброс счётчика PC + принудительный PUSH гипотетически могут решить эту проблему."/>
    </comp>
    <comp lib="9" loc="(240,55)" name="Text">
      <a name="text" val="Полученные сжатые данные будут храниться в ОЗУ."/>
    </comp>
    <comp lib="9" loc="(275,30)" name="Text">
      <a name="text" val="Сложная система сжатия. На вход подаются данные строки. "/>
    </comp>
    <comp lib="9" loc="(310,1220)" name="Text">
      <a name="text" val="Тест на 32 пройден"/>
    </comp>
    <comp lib="9" loc="(315,1245)" name="Text">
      <a name="text" val="Тест на нечёт пройден"/>
    </comp>
    <comp lib="9" loc="(400,510)" name="Text">
      <a name="text" val="Тут хранится строка"/>
    </comp>
    <comp lib="9" loc="(430,670)" name="Text">
      <a name="text" val="Счётчик строки"/>
    </comp>
    <comp lib="9" loc="(440,1155)" name="Text">
      <a name="text" val="Теперь оно... эээ.. ну вроде работает"/>
    </comp>
    <comp lib="9" loc="(515,1175)" name="Text">
      <a name="text" val="Но как немецкий автомобиль - со своими приколами"/>
    </comp>
    <comp lib="9" loc="(530,215)" name="Text">
      <a name="text" val="Выборка бита"/>
    </comp>
    <comp lib="9" loc="(680,355)" name="Text">
      <a name="text" val="Сравнение цвета и бита"/>
    </comp>
    <comp lib="9" loc="(720,1070)" name="Text">
      <a name="text" val="триггер решает проблему срабатываения PUSH на 0000110"/>
    </comp>
    <comp lib="9" loc="(800,1335)" name="Text">
      <a name="font" val="SansSerif bold 64"/>
      <a name="text" val="IT'S ALIIIIIIIVE (нет)"/>
    </comp>
